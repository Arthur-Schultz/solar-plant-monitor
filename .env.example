# Copie este arquivo para .env.local e coloque sua chave do Google AI Studio:
# https://aistudio.google.com/apikey
# O .env.local fica fora do Git (.gitignore: *.local) e a chave nunca vai para o navegador.
GEMINI_API_KEY=
# Opcional: troque o modelo se o padrão não estiver disponível no seu plano
GEMINI_MODEL=gemini-3.5-flash
